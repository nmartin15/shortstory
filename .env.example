# shortstoryfun — copy to .env and fill in values
# Create an OpenRouter key WITH A SPENDING LIMIT: https://openrouter.ai/keys

OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cheap volume tier (default for all stages)
# Recommended: deepseek — reliable prose, low cost
DRAFT_MODEL=deepseek/deepseek-v4.1-flash
# Alternative: qwen/qwen3.8-27b

# Strong tier — only used when you pass --premium / UI premium flag
PREMIUM_MODEL=moonshotai/kimi-k3.1-pro

# Optional
LLM_TEMPERATURE=0.7
BUDGET_CAP_USD=1.00

# Local UI (use 5001 if macOS AirPlay occupies 5000)
HOST=127.0.0.1
PORT=5001
FLASK_ENV=development
