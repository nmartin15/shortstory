# shortstoryfun — copy to .env and fill in values
# Create an OpenRouter key WITH A SPENDING LIMIT: https://openrouter.ai/keys

OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cheap volume tier (default for all stages)
DRAFT_MODEL=qwen/qwen3.8-27b
# Alternative draft model: deepseek/deepseek-v4.1-flash

# Strong tier — only used when you pass --premium / UI premium flag
PREMIUM_MODEL=moonshotai/kimi-k3.1-pro

# Optional
LLM_TEMPERATURE=0.7
BUDGET_CAP_USD=1.00

# Local UI
HOST=127.0.0.1
PORT=5000
FLASK_ENV=development
